<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#07111B">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" app:implementationMode="performance"/>
    <ru.fpvclub.tracker.ui.TargetOverlayView android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="14dp" android:background="#CC07111B">
        <TextView android:id="@+id/stateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IDLE" android:textColor="#A9BBC9" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:id="@+id/debugText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Обведите цель рамкой" android:textColor="#A9BBC9" android:textSize="12sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/newTarget" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Новая цель"/>
            <Button android:id="@+id/reset" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Сброс"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
