[
  {
    "id": "ep2_esp8285_sx1280",
    "name": "HappyModel EP1/EP2 — ESP8285 + SX1280",
    "kind": "receiver",
    "controller": {
      "family": "esp8285",
      "serviceTransport": "esp_rom",
      "defaultOffsets": [
        "0x0"
      ],
      "bootMethod": "boot_pad_gnd"
    },
    "radio": {
      "family": "sx1280",
      "serviceKind": "register_service",
      "access": "controller_spi_or_service_bridge",
      "microcodeUpdate": false
    },
    "hostProtocols": [
      "ep2_link_ascii",
      "crsf_diagnostics"
    ],
    "notes": [
      "Модель платы нельзя надёжно определить только по ESP8285 ROM; при пустой flash профиль выбирается вручную.",
      "Для обычного firmware.bin ESP8285 адрес записи по умолчанию 0x0.",
      "SX1280 обслуживается отдельно по SPI и не получает этот firmware.bin."
    ],
    "elrs": {
      "targetPath": "happymodel.rx_2400.ep",
      "productName": "HappyModel EP1/EP2 2.4GHz RX",
      "platform": "esp8285",
      "firmware": "Unified_ESP8285_2400_RX"
    }
  },
  {
