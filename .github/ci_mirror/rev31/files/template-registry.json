{
  "schema_version": "0.2",
  "product": "EMMana-Next",
  "synthesis_method": "frequency-scale-seed-v1",
  "parameter_ui": "registry-driven-v1",
  "note": "Template parameters are external UI metadata; generated project remains pure EMNX.",
  "templates": [
    {
      "id": "halfwave-dipole",
      "label": "Полуволновый диполь",
      "status": "implemented",
      "seed_model": "benchmarks/B01_halfwave_dipole_51seg.emnx",
      "family": "dipole",
      "solver_compatibility": [
        "wire-mom"
      ],
      "trust": "reference-validated",
      "supports_optimizer": false,
      "parameters": [
        {
          "id": "element_length_m",
          "label": "Общая длина",
          "ui_unit": "cm",
          "default_lambda": 0.5,
          "min_lambda": 0.3,
          "max_lambda": 0.7,
          "step": 0.1,
          "binding": {
            "kind": "wire_length",
            "wire_id": "W1"
          }
        },
        {
          "id": "diameter_m",
          "label": "Диаметр провода",
          "ui_unit": "mm",
          "default_lambda": 0.002,
          "min_lambda": 0.0002,
          "max_lambda": 0.02,
          "step": 0.1,
          "binding": {
            "kind": "wire_diameter_all"
          }
        },
        {
          "id": "segments",
          "label": "Сегментов",
          "ui_unit": "count",
          "default": 51,
          "min": 5,
          "max": 151,
          "step": 2,
          "binding": {
            "kind": "wire_segments_all"
          }
        }
      ],
      "outputs": [
        "emnx-project"
      ],
      "use_cases": [
        "baseline",
        "single-band wire antenna"
      ]
    },
